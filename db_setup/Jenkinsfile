// No 'pipeline' header here if using 'load'
stage('Deploy MySQL') {
    echo "Running deployment on agent: ${env.NODE_NAME}"
    sh """
        docker network create ${NETWORK_NAME} || true
        docker rm -f ${CONTAINER_NAME} || true
        docker run -d --name ${CONTAINER_NAME} \
            --network ${NETWORK_NAME} \
            -p 3306:3306 \
            -e MYSQL_ROOT_PASSWORD=${MYSQL_PW} \
            ${BASE_IMAGE}
    """
}

stage('Verify Health') {
    sh """
        echo "Waiting for MySQL to start..."
        # Try 10 times, waiting 5 seconds between each
        for i in {1..10}; do
            if docker exec -e MYSQL_PWD=$MYSQL_PW $CONTAINER_NAME mysqladmin ping -h localhost; then
                echo "MySQL is alive!"
                exit 0
            fi
            echo "MySQL is still booting up... (Attempt \$i/10)"
            sleep 5
        done
        echo "MySQL failed to start."
        docker logs $CONTAINER_NAME
        exit 1
    """
}

return this; // Crucial for 'load' to work correctly